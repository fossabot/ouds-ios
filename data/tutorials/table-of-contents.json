{"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/table-of-contents"]}],"metadata":{"estimatedTime":"2hr 5min","categoryPathComponent":"Table-Of-Contents","role":"overview","title":"Swift Package iOS Tutorial","category":"Orange Unified Design System"},"kind":"overview","hierarchy":{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","paths":[]},"sections":[{"action":{"type":"reference","isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"kind":"hero","content":[{"type":"paragraph","inlineContent":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}]}],"title":"Swift Package iOS Tutorial","backgroundImage":"ic_unified_ds.png","image":"ic_unified_ds.png"},{"kind":"volume","name":null,"image":null,"content":[],"chapters":[{"image":"ic_unified_ds.png","content":[{"inlineContent":[{"type":"text","text":"In this chapter you will learn how to import the OUDS iOS Swift Package and which librairies it provides"},{"type":"text","text":" "},{"type":"text","text":"you should choose for your needs"}],"type":"paragraph"}],"name":"Import of the Swift Package and choose its librairies","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies"]},{"image":"ic_theme_intro.png","content":[{"inlineContent":[{"type":"text","text":"In this chapter you will see how to instanciate a theme and inject it inside your app"}],"type":"paragraph"}],"name":"Preparation of the theme","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme"]},{"image":"ic_component_intro.png","content":[{"inlineContent":[{"type":"text","text":"In this chapter you will see how you can use your first components provided by OUDS Swift Package"}],"type":"paragraph"}],"name":"Use of first components provided by OUDS","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components"]},{"image":"ic_component_intro.png","content":[{"inlineContent":[{"type":"text","text":"In this chapter you will use original components of OUDS and richer ones"}],"type":"paragraph"}],"name":"Richer and more original components of OUDS","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components"]},{"image":"ic_design_token_intro.png","content":[{"inlineContent":[{"type":"text","text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how."}],"type":"paragraph"}],"name":"Typography, view modifiers and tokens","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things"]},{"image":"ic_unified_ds.png","content":[{"inlineContent":[{"type":"text","text":"You can have questions and issues, and there are resources online. Let’s see that together."}],"type":"paragraph"}],"name":"Go further with more ressources","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further"]}]}],"references":{"ic_unified_ds.png":{"type":"image","alt":"Logo of OUDS","variants":[{"url":"\/images\/OUDSThemesContract\/ic_unified_ds.png","traits":["1x","light"]}],"identifier":"ic_unified_ds.png"},"ic_design_token_intro.png":{"type":"image","alt":"OUDS tokens logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}],"identifier":"ic_design_token_intro.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-6-going-further":{"estimatedTime":"10min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-6-going-further","abstract":[{"text":"Since you have learnt how OUDS works with theme, themeable view, components, tuning and vieww modifiers, it is time now to discover some online resources.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further","title":"Going further with more resources","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-1-package-and-librairies":{"estimatedTime":"10min","kind":"project","type":"topic","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-1-package-and-librairies","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies","title":"Swift Package integration","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-4-use-other-components":{"estimatedTime":"30min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-4-use-other-components","abstract":[{"text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components","title":"Add more OUDS components","role":"project"},"ic_component_intro.png":{"type":"image","alt":"Logo of OUDS","variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"identifier":"ic_component_intro.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things":{"estimatedTime":"30min","kind":"project","type":"topic","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things","title":"Styling things","role":"project"},"ic_theme_intro.png":{"type":"image","alt":"OUDS themes logo","variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}],"identifier":"ic_theme_intro.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-2-instanciate-theme":{"estimatedTime":"15min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-2-instanciate-theme","abstract":[{"text":"The theme is exposed as one object which will be injected inside your SwiftUI view.","type":"text"},{"text":" ","type":"text"},{"text":"The theme provides all tokens which defines in the end the rendering of everything.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme","title":"Instanciate and inject a theme","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-3-use-first-components":{"estimatedTime":"30min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-3-use-first-components","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components","title":"Use your first OUDS components","role":"project"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents":{"kind":"overview","type":"topic","url":"\/tutorials\/table-of-contents","abstract":[{"text":"Discovering a new framework can be exciting and scary. Learn how you can embed and use OUDS Swift Package.","type":"text"},{"text":" ","type":"text"},{"text":"With this tutorial you will learn fundamental concepts of Orange Unified Design System and discover the layers of this framework.","type":"text"},{"text":" ","type":"text"},{"text":"Theme, components, tokens… everything will be introduced!","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","title":"Swift Package iOS Tutorial","role":"overview"}}}