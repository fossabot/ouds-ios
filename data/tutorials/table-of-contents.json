y OUDS Swift Package","type":"text"}]}]},{"image":"ic_component_intro.png","name":"Richer and more original components of OUDS","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components"],"content":[{"type":"paragraph","inlineContent":[{"text":"In this chapter you will use original components of OUDS and richer ones","type":"text"}]}]},{"image":"ic_design_token_intro.png","name":"Typography, view modifiers and tokens","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things"],"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS is not only about components and themes. It provides view modifiers, typographies and tokens which can be used. You will learn how.","type":"text"}]}]},{"image":"ic_unified_ds.png","name":"Go further with more ressources","tutorials":["doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further"],"content":[{"type":"paragraph","inlineContent":[{"text":"You can have questions and issues, and there are resources online. Let’s see that together.","type":"text"}]}]}],"kind":"volume","name":null,"image":null,"content":[]}],"hierarchy":{"paths":[],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/table-of-contents"]}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"categoryPathComponent":"Table-Of-Contents","role":"overview","category":"Orange Unified Design System","estimatedTime":"2hr 5min","title":"Swift Package iOS Tutorial"},"kind":"overview","references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things":{"url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, 