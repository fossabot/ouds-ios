ncreases a lot the size of the repository."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"OUDS is open source, public and uses GitHub as forge. Thus, you will find common things inside the "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","isActive":true,"type":"reference"},{"type":"text","text":" GitHub repository."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"tutorial-6-5.png","code":null,"caption":[{"inlineContent":[{"type":"text","text":"Do not hesitate to "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/issues","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/discussions","isActive":true},{"type":"text","text":"!"}],"type":"paragraph"}]}],"anchor":"More-resources"}]}],"references":{"ic_theme_intro.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/ic_theme_intro.png","traits":["1x","light"]}],"type":"image","alt":"OUDS themes logo","identifier":"ic_theme_intro.png"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-1-package-and-librairies#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","url":"\/tutorials\/oudsthemescontract\/tutorial-1-package-and-librairies#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies#Check-Your-Understanding","title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things#Use-of-tokens":{"abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"title":"Use of tokens","type":"section","kind":"section","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Use-of-tokens","role":"p