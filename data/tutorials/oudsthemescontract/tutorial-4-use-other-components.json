{"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/oudsthemescontract\/tutorial-4-use-other-components"]}],"metadata":{"role":"project","category":"Orange Unified Design System","title":"Add more OUDS components","categoryPathComponent":"Table-Of-Contents"},"kind":"project","hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies#Import-the-Swift-Package-and-the-libraries","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Import-of-the-Swift-Package-and-choose-its-librairies"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme#Basic-structure-for-the-app","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Preparation-of-the-theme"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components#Add-basic-components","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Use-of-first-components-provided-by-OUDS"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components#Add-basic-components","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Richer-and-more-original-components-of-OUDS"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Use-of-tokens","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Use-of-view-modifiers","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Final-result","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Want-to-be-an-artist","kind":"task"},{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Check-Your-Understanding","kind":"assessment"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Typography,-view-modifiers-and-tokens"},{"projects":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further","sections":[{"reference":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further#More-resources","kind":"task"}]}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Go-further-with-more-ressources"}],"reference":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","paths":[["doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Richer-and-more-original-components-of-OUDS"]]},"sections":[{"chapter":"Richer and more original components of OUDS","estimatedTimeInMinutes":30,"content":[{"inlineContent":[{"type":"text","text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs."}],"type":"paragraph"}],"kind":"hero","xcodeRequirement":"Xcode 26.2","backgroundImage":"ic_component_intro.png","title":"Add more OUDS components","image":"ic_component_intro.png"},{"tasks":[{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"The tags are small labels bringing pieces of information so as to give more context to the users. They are very simple to use.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add three tags thanks to "},{"code":"OUDSTag","type":"codeVoice"},{"type":"text","text":" object."}]}],"code":"tutorial-4-1.swift","media":null,"runtimePreview":"tutorial-4-1.png"},{"code":"tutorial-4-2.swift","media":null,"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Add a group of chips for some topics the user must select. The picker is populated by an array of data, and the one we use as a "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" of array."},{"text":" ","type":"text"},{"text":"The user can select all of the items.","type":"text"}],"type":"paragraph"}],"runtimePreview":"tutorial-4-2.png","content":[{"inlineContent":[{"type":"text","text":"Chips can be considered as interactive tags. OUDS provides "},{"code":"OUDSSuggestionChip","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OUDSFilterChip"},{"text":" depending to the needs of the users.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Just like the radio buttons and the checkboxes, OUDS package provides a "},{"type":"codeVoice","code":"OUDSChipPicker"},{"type":"text","text":" to add quickly a group of chips and select some of them using specific rule."},{"type":"text","text":" "},{"type":"text","text":"This component is not official but can be helpful."}],"type":"paragraph"}]},{"code":"tutorial-4-3.swift","type":"step","content":[{"inlineContent":[{"text":"Formulars without input text are not formulars. OUDS provide an ","type":"text"},{"code":"OUDSTextInput","type":"codeVoice"},{"text":" to let use write some text.","type":"text"},{"text":" ","type":"text"},{"text":"This component is very rich: preffix and suffix can be defined, and also helper text and links. An icon can be added and a trailing action.","type":"text"}],"type":"paragraph"}],"runtimePreview":"tutorial-4-3.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add two text inputs: one to get the user name with a delete action, and one for an email address."},{"type":"text","text":" "},{"text":"Their values are exposed through ","type":"text"},{"code":"Binding","type":"codeVoice"},{"type":"text","text":" of "},{"type":"codeVoice","code":"String"},{"text":".","type":"text"}]}],"media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"In some conditions, components need to be placed on colored surface. Indeed such colored surfaces make their components strongs and increase the efficiency and the onboarding of the users.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"However some components like text, button and link must act differently if they are in such surfaces. For example they must use the monochrome colors."},{"text":" ","type":"text"},{"type":"text","text":"In addition the colored surface brings a small set of colors so as to be sure contrasts and rendering of components are acceptable and all combinations tested."},{"text":" ","type":"text"},{"text":"Nevertheless some components with particular appearances must not be added in such surface, it is forbidden by design. Developers must check the documentation of the component and also apply the specifications of their designers who know these rules thanks to the Figma OUDS assets.","type":"text"}]}],"caption":[{"inlineContent":[{"type":"text","text":"Add a "},{"code":"OUDSColoredSurface","type":"codeVoice"},{"type":"text","text":" gathering the link, the button and the switch item. You will need to get the theme object for your first time so as to choose the color of the surface! The import of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDSTokensSemantic"}]},{"type":"text","text":" is also necessary. Once your code is updated, compare the difference for the switch, the link and the button. Their style has changed!"}],"type":"paragraph"}],"code":"tutorial-4-4.swift","media":null,"runtimePreview":"tutorial-4-4.png"}],"title":"Add basic components","anchor":"Add-basic-components","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Some components like tags are original, and others like text input are richer. Let’s play with them!","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]}],"kind":"tasks"},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"content":[],"type":"multiple-choice","choices":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never, I can just change the background"}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Even if you apply the color you want on the background, it will not be enough because some components can have accessibility issues with bad WCAG ratios. Colored surface provides small set of colors for which components are ready."}]}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"text","text":"No, you should see with your designer so as to know when a colored surface must be used."},{"type":"text","text":" "},{"type":"text","text":"Or if you do not have designers, be an artist and test what is pleasant for you!"}],"type":"paragraph"}],"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"Always, thus my components feel good"}],"type":"paragraph"}]},{"justification":[{"inlineContent":[{"type":"text","text":"In most of cases components should not be in monochrome mode and colored surface used. See with your designers the cases when you will have to use the "},{"type":"codeVoice","code":"OUDSColoredSurface"},{"type":"text","text":". Or be an artist and test what is pleasant for you!"}],"type":"paragraph"}],"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"Sometimes, it depends to the context"}],"type":"paragraph"}]}],"title":[{"type":"paragraph","inlineContent":[{"text":"In which case should I use the colored surface?","type":"text"}]}]}]},{"kind":"callToAction","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things","overridingTitle":"Get started","isActive":true},"title":"Styling things","abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"featuredEyebrow":"Tutorial"}],"references":{"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-4-use-other-components#Check-Your-Understanding":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components#Check-Your-Understanding","url":"\/tutorials\/oudsthemescontract\/tutorial-4-use-other-components#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-1-package-and-librairies":{"estimatedTime":"10min","kind":"project","type":"topic","abstract":[{"text":"OUDS iOS is exposed through an open source Swift Package hosted on GitHub, and provides several librairies for your needs.","type":"text"},{"text":" ","type":"text"},{"text":"These librairies help to split products and make users able to select only what they need.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI is the only official supported framework.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-1-package-and-librairies","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies","title":"Swift Package integration","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-4-use-other-components#Add-basic-components":{"kind":"section","type":"section","abstract":[{"text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-4-use-other-components#Add-basic-components","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components#Add-basic-components","title":"Add basic components","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents/Import-of-the-Swift-Package-and-choose-its-librairies":{"url":"\/tutorials\/table-of-contents\/import-of-the-swift-package-and-choose-its-librairies","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Import-of-the-Swift-Package-and-choose-its-librairies","type":"topic","role":"article","kind":"article","abstract":[],"title":"Import of the Swift Package and choose its librairies"},"Xcode 26.2":{"title":"Xcode 26.2","identifier":"Xcode 26.2","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents/Typography,-view-modifiers-and-tokens":{"kind":"article","type":"topic","url":"\/tutorials\/table-of-contents\/typography,-view-modifiers-and-tokens","abstract":[],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Typography,-view-modifiers-and-tokens","title":"Typography, view modifiers and tokens","role":"article"},"ic_component_intro.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSThemesContract\/ic_component_intro.png"}],"alt":"OUDS components logo","identifier":"ic_component_intro.png","type":"image"},"tutorial-4-3.swift":{"syntax":"swift","fileName":"Content.swift","type":"file","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","    @State var selectedTopics: [Topics] = []","    @State var identity: String = \"\"","    @State var email: String = \"\"","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            HStack {","                OUDSTag(label: \"Welcome\")","                OUDSTag(label: \"OUDS\")","                OUDSTag(label: \"Tutorial\")","            }","","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            let identityDeleteAction = OUDSTextInput.TrailingAction(icon: Image(systemName: \"trash\"), actionHint: \"Delete\") { identity = \"\" }","            OUDSTextInput(label: \"Identity\", text: $identity, placeholder: \"Firstname and lastname\", trailingAction: identityDeleteAction)","","            OUDSTextInput(label: \"Email\", text: $email,","                          placeholder: \"Email address\",","                          suffix: \".com\",","                          leadingIcon: Image(systemName: \"envelope\"),","                          helperText: \"The email will be automatically completed with @orange.com\")","","            OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(isOn: $termsAccepted, label: \"I accept the terms of use\")","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","","            OUDSButton(text: \"Create my profile\",","                       appearance: .strong,","                       style: creatingProfile ? .loading : .default)","            {","                creatingProfile = true","                DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                    creatingProfile = false","                }","            }.disabled(!termsAccepted)","","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileType":"swift","highlights":[{"line":24},{"line":25},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49}],"identifier":"tutorial-4-3.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things#Want-to-be-an-artist":{"kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things#Want-to-be-an-artist","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Want-to-be-an-artist","title":"Want to be an artist?","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents/Use-of-first-components-provided-by-OUDS":{"kind":"article","type":"topic","url":"\/tutorials\/table-of-contents\/use-of-first-components-provided-by-ouds","abstract":[],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Use-of-first-components-provided-by-OUDS","title":"Use of first components provided by OUDS","role":"article"},"tutorial-4-2.png":{"alt":"Chips are now integrated inside a picker","identifier":"tutorial-4-2.png","type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-4-2.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-2-instanciate-theme#Basic-structure-for-the-app":{"kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-2-instanciate-theme#Basic-structure-for-the-app","abstract":[{"text":"The theme is exposed as one object which will be injected inside your SwiftUI view.","type":"text"},{"text":" ","type":"text"},{"text":"The theme provides all tokens which defines in the end the rendering of everything.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-2-instanciate-theme#Basic-structure-for-the-app","title":"Basic structure for the app","role":"pseudoSymbol"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents/Preparation-of-the-theme":{"kind":"article","type":"topic","url":"\/tutorials\/table-of-contents\/preparation-of-the-theme","abstract":[],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/Table-Of-Contents\/Preparation-of-the-theme","title":"Preparation of the theme","role":"article"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-3-use-first-components#Add-basic-components":{"kind":"section","type":"section","url":"\/tutorials\/oudsthemescontract\/tutorial-3-use-first-components#Add-basic-components","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components#Add-basic-components","title":"Add basic components","role":"pseudoSymbol"},"tutorial-4-2.swift":{"syntax":"swift","type":"file","fileName":"Content.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","    @State var selectedTopics: [Topics] = []","","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            HStack {","                OUDSTag(label: \"Welcome\")","                OUDSTag(label: \"OUDS\")","                OUDSTag(label: \"Tutorial\")","            }","","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(isOn: $termsAccepted, label: \"I accept the terms of use\")","","            OUDSSwitchItem(\"Switch to dark mode\", isOn: $switchToDarkMode)","","            OUDSLink(text: \"Go to the website\", indicator: .next) {","                openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","            }","","            OUDSButton(text: \"Create my profile\",","                       appearance: .strong,","                       style: creatingProfile ? .loading : .default)","            {","                creatingProfile = true","                DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                    creatingProfile = false","                }","            }.disabled(!termsAccepted)","","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileType":"swift","highlights":[{"line":23},{"line":39},{"line":40},{"line":66},{"line":67},{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78},{"line":79},{"line":80},{"line":81}],"identifier":"tutorial-4-2.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-1-package-and-librairies#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-1-package-and-librairies#Check-Your-Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-1-package-and-librairies#Check-Your-Understanding","type":"link","title":"Check Your Understanding"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things#Use-of-view-modifiers":{"url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things#Use-of-view-modifiers","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Use-of-view-modifiers","type":"section","role":"pseudoSymbol","kind":"section","abstract":[{"type":"text","text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that."}],"title":"Use of view modifiers"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things":{"estimatedTime":"30min","kind":"project","type":"topic","abstract":[{"text":"Even if components increase the identity of your apps, it is not enough. Typography, fonts and tokens are here to improve that.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things","title":"Styling things","role":"project"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-6-going-further#More-resources":{"kind":"section","type":"section","abstract":[{"text":"Since you have learnt how OUDS works with theme, themeable view, components, tuning and vieww modifiers, it is time now to discover some online resources.","type":"text"}],"url":"\/tutorials\/oudsthemescontract\/tutorial-6-going-further#More-resources","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-6-going-further#More-resources","title":"More resources","role":"pseudoSymbol"},"tutorial-4-4.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/tutorial-4-4.png","traits":["1x","light"]}],"alt":"The colored surfce changes the styles of some components","identifier":"tutorial-4-4.png","type":"image"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-4-use-other-components":{"estimatedTime":"30min","kind":"project","type":"topic","url":"\/tutorials\/oudsthemescontract\/tutorial-4-use-other-components","abstract":[{"text":"Components can be similar to iOS native components, or can also be original and strongly related to Orange Unified Design System needs.","type":"text"}],"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-4-use-other-components","title":"Add more OUDS components","role":"project"},"tutorial-4-4.swift":{"syntax":"swift","type":"file","fileName":"Content.swift","content":["\/\/","\/\/ Software Name: OUDS iOS","\/\/ SPDX-FileCopyrightText: Copyright (c) Orange SA","\/\/ SPDX-License-Identifier: MIT","\/\/","\/\/ This software is distributed under the MIT license,","\/\/ the text of which is available at https:\/\/opensource.org\/license\/MIT\/","\/\/ or see the \"LICENSE\" file for more details.","\/\/","\/\/ Authors: See CONTRIBUTORS.txt","\/\/ Software description: A SwiftUI components library with code examples for Orange Unified Design System","\/\/","","import OUDSSwiftUI","import SwiftUI","","struct ContentView: View {","","    @State var selectedGender: Genders = .male","    @State var termsAccepted: Bool = false","    @State var switchToDarkMode: Bool = false","    @State var creatingProfile: Bool = false","    @State var selectedTopics: [Topics] = []","    @State var identity: String = \"\"","    @State var email: String = \"\"","","    @Environment(\\.theme) var theme","    @Environment(\\.openURL) var openUrl","","    var body: some View {","        VStack {","            HStack {","                OUDSTag(label: \"Welcome\")","                OUDSTag(label: \"OUDS\")","                OUDSTag(label: \"Tutorial\")","            }","","            OUDSRadioPicker(selection: $selectedGender,","                            radios: genderRadioValues(),","                            placement: .horizontal(false))","","            let identityDeleteAction = OUDSTextInput.TrailingAction(icon: Image(systemName: \"trash\"), actionHint: \"Delete\") { identity = \"\" }","            OUDSTextInput(label: \"Identity\", text: $identity, placeholder: \"Firstname and lastname\", trailingAction: identityDeleteAction)","","            OUDSTextInput(label: \"Email\", text: $email,","                          placeholder: \"Email address\",","                          suffix: \".com\",","                          leadingIcon: Image(systemName: \"envelope\"),","                          helperText: \"The email will be automatically completed with @orange.com\")","","            OUDSChipPicker(selections: $selectedTopics, chips: topicsChipsValues())","","            OUDSHorizontalDivider(color: .brandPrimary)","","            OUDSCheckboxItem(isOn: $termsAccepted, label: \"I accept the terms of use\")","","            OUDSColoredSurface(color: theme.colorModes.onStatusInfoEmphasized) {","                VStack(alignment: .center, spacing: theme.spaces.fixedXsmall) {","                    OUDSLink(text: \"Go to the website\", indicator: .next) {","                        openUrl.callAsFunction(URL(string: \"https:\/\/ios.unified-design-system.orange.com\")!)","                    }","","                    OUDSButton(text: \"Create my profile\",","                               appearance: .strong,","                               style: creatingProfile ? .loading : .default)","                    {","                        creatingProfile = true","                        DispatchQueue.main.asyncAfter(deadline: .now() + 5) {","                            creatingProfile = false","                        }","                    }.disabled(!termsAccepted)","","                    OUDSSwitchItem(\"Switch to dark mode\",","                                   isOn: $switchToDarkMode)","                        .padding(.horizontal, theme.spaces.fixed3xlarge)","                }","                .frame(maxWidth: .infinity)","                .padding(.bottom, theme.spaces.fixedLarge)","            }","","        }.preferredColorScheme(switchToDarkMode ? .dark : .light)","    }","","    \/\/ MARK: - Utils","","    enum Topics: String, Hashable {","        case food","        case music","        case gardening","        case sport","    }","","    func topicsChipsValues() -> [OUDSChipPickerData<Topics>] {","        [","            OUDSChipPickerData(tag: Topics.food, layout: .text(text: \"Food\")),","            OUDSChipPickerData(tag: Topics.music, layout: .text(text: \"Music\")),","            OUDSChipPickerData(tag: Topics.gardening, layout: .text(text: \"Gardening\")),","            OUDSChipPickerData(tag: Topics.sport, layout: .text(text: \"Sport\")),","        ]","    }","","    enum Genders: String, Hashable {","        case male","        case female","        case nonBinary","    }","","    func genderRadioValues() -> [OUDSRadioPickerData<Genders>] {","        [","            OUDSRadioPickerData(tag: Genders.male, label: \"Mr\"),","            OUDSRadioPickerData(tag: Genders.female, label: \"Ms\"),","            OUDSRadioPickerData(tag: Genders.nonBinary, label: \"Other\"),","        ]","    }","}"],"fileType":"swift","highlights":[{"line":27},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68},{"line":69},{"line":70},{"line":71},{"line":73},{"line":74},{"line":75},{"line":77},{"line":78},{"line":79}],"identifier":"tutorial-4-4.swift"},"doc://OUDSThemesContract/tutorials/OUDSThemesContract/tutorial-5-styling-things#Check-Your-Understanding":{"url":"\/tutorials\/oudsthemescontract\/tutorial-5-styling-things#Check-Your-Understanding","type":"link","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-5-styling-things#Check-Your-Understanding"},"doc://OUDSThemesContract/tutorials/Table-Of-Contents/Go-further-with-more-ressources":{"kind":"article","type":"topic","url":"\/tutorials\/table-of-contents\/go-fu