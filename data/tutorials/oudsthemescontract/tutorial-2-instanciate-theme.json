,"backgroundImage":"ic_theme_intro.png","content":[{"inlineContent":[{"type":"text","text":"The theme is exposed as one object which will be injected inside your SwiftUI view."},{"type":"text","text":" "},{"type":"text","text":"The theme provides all tokens which defines in the end the rendering of everything."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"title":"Basic structure for the app","contentSection":[{"content":[{"inlineContent":[{"text":"OUDS must be used in SwiftUI projects.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"We suppose you already have an app or a freshly created new one, with OUDS Swift Package integrated and the librairies added to the target.","type":"text"},{"text":" ","type":"text"},{"text":"We supposed also you have Xcode 26 at least, and for example an iPhone 17 Pro Max simulator.","type":"text"},{"text":" ","type":"text"},{"text":"Source code and tokens here are the ones of version 0.20.0 ; things can change in the future.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"inlineContent":[{"text":"Define a basic ","type":"text"},{"code":"App","type":"codeVoice"},{"text":" object using ","type":"text"},{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"emphasis"},{"text":". Add inside a simple text","type":"text"}],"type":"paragraph"}],"runtimePreview":"tutorial-2-1.png","code":"tutorial-2-1.swift","type":"step","caption":[],"media":null},{"content":[{"inlineContent":[{"text":"Import the needed librairies in your file (we suppose here ","type":"text"},{"inlineContent":[{"text":"OUDSSwiftUI","type":"text"}],"type":"emphasis"},{"text":" during all the tutorial).","type":"text"},{"text":" ","type":"text"},{"text":"Instanciate a new object of type ","type":"text"},{"code":"OrangeTheme","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In your app root view, add the "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":" and give it the new theme object."}],"type":"paragraph"}],"runtimePreview":"tutorial-2-2.png","code":"tutorial-2-2.swift","type":"step","caption":[{"inlineContent":[{"text":"Project must compile then. This is until today (API 0.20.0) the only way to instanciated and inject a theme.","type":"text"}],"type":"paragraph"}],"media":null}],"anchor":"Basic-structure-for-the-app"}]},{"assessments":[{"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"text":"Is it mandatory to use today the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":"?","type":"text"}]}],"content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is! Otherwise the theme won’t be defined and available as environment variable."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],"isCorrect":true},{"justification":[{"inlineContent":[{"type":"text","text":"The "},{"code":"OUDSThemeableView","type":"codeVoice"},{"type":"text","text":" is mandatory to inject as environment variable the theme and expose it in every view inside."}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],"isCorrect":false}]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"text":"OUDS provides components ready to be used, specified in Figma assets and preventing users to handle tokens.","type":"text"},{"type":"text","text":" "},{"text":"They are rendered thanks to the theme in use.","type":"text"}],"action":{"identifier":"doc:\/\/OUDSThemesContract\/tutorials\/OUDSThemesContract\/tutorial-3-use-first-components","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true},"title":"Use your first OUDS components"}],"identifier":{"url":"doc:\/\/OUDSThemesContract\/tutor