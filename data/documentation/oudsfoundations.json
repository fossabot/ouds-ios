pe":"text"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PostScriptFontNamesMapKey","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostScriptFontNamesMapKey"}],"title":"PostScriptFontNamesMapKey","url":"\/documentation\/oudsfoundations\/postscriptfontnamesmapkey","navigatorTitle":[{"kind":"identifier","text":"PostScriptFontNamesMapKey"}]},"https://system.design.orange.com/0c1af118d/p/2531b9-accessibility-compliance":{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"link","titleInlineContent":[{"type":"text","text":"the following guidelines"}],"title":"the following guidelines","url":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSLogger":{"role":"symbol","type":"topic","title":"OUDSLogger","url":"\/documentation\/oudsfoundations\/oudslogger","abstract":[{"type":"text","text":"The "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":" wrapper used in the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"OUDS iOS"}]},{"type":"text","text":" library so as to logs things in standard output or elsewhere."}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSLogger","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSLogger"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSLogger"}],"kind":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/PostScriptFontNamesMap":{"role":"symbol","identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/PostScriptFontNamesMap","abstract":[{"text":"Some font family cannot be used as they are because their “marketing” names are unknown to the OS","type":"text"},{"text":" ","type":"text"},{"text":"except their PostScript names.","type":"text"},{"text":" ","type":"text"},{"text":"This dictionnary defines the expected PostScript names of font families known in iOS.","type":"text"},{"text":" ","type":"text"},{"text":"Depending to the font family, several rules are applied, with for example removal of whitespaces","type":"text"},{"text":" ","type":"text"},{"text":"and adding of prefixes of suffixes after the font family name or the weight.","type":"text"}],"title":"PostScriptFontNamesMap","type":"topic","url":"\/documentation\/oudsfoundations\/postscriptfontnamesmap","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostScriptFontNamesMap"}],"navigatorTitle":[{"kind":"identifier","text":"PostScriptFontNamesMap"}],"kind":"symbol"},"doc://OUDSFoundations/documentation/OUDSFoundations/kApplePostScriptFontNames":{"role":"symbol","kind":"symbol","title":"kApplePostScriptFontNames","type":"topic","abstract":[{"text":"Contains the Apple PostScript name of a font given a font family name and a font weight.","type":"text"},{"text":" ","type":"text"},{"text":"Such values have been picked from the Apple Font Book.","type":"text"}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/kApplePostScriptFontNames","url":"\/documentation\/oudsfoundations\/kapplepostscriptfontnames","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kApplePostScriptFontNames"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15OUDSFoundations22PostScriptFontNamesMapa","kind":"typeIdentifier","text":"PostScriptFontNamesMap"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/SwiftUICore":{"abstract":[],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/SwiftUICore","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/oudsfoundations\/swiftuicore","title":"SwiftUICore"},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSWCAG21Ratio":{"role":"symbol","title":"OUDSWCAG21Ratio","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"OUDSWCAG21Ratio"}],"abstract":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"text":" ","type":"text"},{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"text":" ","type":"text"},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"text":" ","type":"text"},{"text":"This utility helps to define wether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSWCAG21Ratio","url":"\/documentation\/oudsfoundations\/oudswcag21ratio","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSWCAG21Ratio"}]},"doc://OUDSFoundations/documentation/OUDSFoundations/OUDSUserInterfaceSizeClass":{"abstract":[{"type":"text","text":"Enumerates the size classes defined by the design system."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"text":"extraCompact","type":"text"}]},{"type":"text","text":" size class if for screens with width < 389."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"compact"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"regular"}]},{"type":"text","text":" size classes are the standard Apple classes."}],"identifier":"doc:\/\/OUDSFoundations\/documentation\/OUDSFoundations\/OUDSUserInterfaceSizeClass","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSUserInterfaceSizeClass","kind":"identifier"}],"url":"\/documentation\/oudsfoundations\/oudsuserinterfacesizeclass","title":"OUDSUserInterfaceSizeClass","navigatorTitle":[{"text":"OUDSUserInterfaceSizeClass","kind":"identifier"}]}}}