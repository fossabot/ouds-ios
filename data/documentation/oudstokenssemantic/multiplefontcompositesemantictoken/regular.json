icToken","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken","role":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticToken":{"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticToken","title":"FontCompositeSemanticToken","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FontCompositeSemanticToken"}],"navigatorTitle":[{"kind":"identifier","text":"FontCompositeSemanticToken"}],"type":"topic","role":"symbol","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictoken","kind":"symbol","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" global design system, composite tokens are defined for font-related things."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here a "},{"type":"emphasis","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":" thing is caracterized by a "},{"type":"emphasis","inlineContent":[{"text":"font size","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"line height","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"text":"font weight","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"letter spacing","type":"text"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":" thing."}]},"ic_design_token_figma_semantic.png":{"type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSTokensSemantic\/ic_design_token_figma_semantic.png"}],"identifier":"ic_design_token_figma_semantic.png"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"role":"collection","title":"Tokens for semantics","images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"url":"\/documentation\/oudstokenssemantic","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","type":"topic","abstract":[{"text":"These ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as an high level of usage with functional meanings.","type":"text"}],"kind":"symbol"}}}