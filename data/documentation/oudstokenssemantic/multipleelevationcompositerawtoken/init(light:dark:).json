ype":"emphasis"},{"text":" for ","type":"text"},{"inlineContent":[{"type":"text","text":"elevation"}],"type":"emphasis"},{"text":" effect.","type":"text"},{"text":" ","type":"text"},{"text":"It is defined as a ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NSObject","type":"codeVoice"},{"text":" so as to be shared through ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" with extensions and protocols within modules.","type":"text"}],"kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic":{"kind":"symbol","images":[{"type":"icon","identifier":"ic_design_token_figma_semantic.png"}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"text":"tokens","type":"text"}],"type":"emphasis"},{"text":" can be used mainly for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"component tokens","type":"text"}]},{"text":" to apply some style and configuration values ; today ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"type":"text","text":" or "},{"inlineContent":[{"type":"text","text":"components"}],"type":"emphasis"},{"text":" are not defined yet.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"type":"topic","url":"\/documentation\/oudstokenssemantic","role":"collection","title":"Tokens for semantics"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleElevationCompositeRawToken":{"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/oudstokenssemantic\/multipleelevationcompositerawtoken","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleElevationCompositeRawToken","