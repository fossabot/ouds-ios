enssemantic\/fontsemantictokens","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSemanticTokens","type":"topic","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"inlineContent":[{"type":"text","text":"font"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all font semantic tokens a theme must have"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontFamilySemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontWeightSemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSizeSemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontLineHeightSemanticToken","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"However the composite tokens (here the ones gathering each type of semantic token here) are defined in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","isActive":true},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any font semantic token must be declared there (except "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","isActive":true},{"text":").","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FontSemanticTokens","kind":"identifier"}],"kind":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/FontCompositeSemanticTokens":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FontCompositeSemanticTokens","kind":"identifier"}],"title":"FontCompositeSemanticTokens","kind":"symbol","type":"topic","navigatorTitle":[{"text":"FontCompositeSemanticTokens","kind":"identifier"}],"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"inlineContent":[{"type":"text","text":"fonts"}],"type":"strong"},{"type":"text","text":", but only "},{"type":"strong","inlineContent":[{"type":"text","text":"composite tokens"}]},{"type":"text","text":" in the end."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontSemanticTokens","isActive":true},{"type":"text","text":" as the "},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"type":"text","text":" tool parsing "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/FontCompositeSemanticTokens","url":"\/documentation\/oudstokenssemantic\/fontcompositesemantictokens","role":"symbol"},"doc://OUDSTokensSemantic/documentation/OUDSTokensSemantic/MultipleFontCompositeSemanticToken":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"title":"MultipleFontCompositeSemanticToken","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"FontCompositeSemanticToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"type":"reference","identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/OUDSTokensSemantic\/documentation\/OUDSTokensSemantic\/MultipleFontCompositeSemanticToken","url":"\/documentation\/oudstokenssemantic\/multiplefontcompositesemantictoken","role":"symbol"}}}