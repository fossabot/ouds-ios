{"hierarchy":{"paths":[["doc:\/\/OUDSThemesOrange\/documentation\/OUDSThemesOrange"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrangeThemeRadioButtonComponentTokensProvider"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"code":["    \/\/ Define your own provider for radio button component tokens","    \/\/ by inheriting from existing provider","    class CustomRadioButtonComponentTokensProvider: OrangeThemeRadioButtonComponentTokensProvider {","","        \/\/ Then override the radio button component tokens you want.","","        override var sizeMinWidth: SizeSemanticToken { sizes.iconWithLabelLargeSizeXl }","","        override var borderWidthSelected: BorderWidthSemanticToken { borders.widthThin }","","        \/\/ ...","    }","","    \/\/ Or define your own provider from scratch","    class CustomRadioButtonComponentTokensProvider: RadioButtonComponentTokens {","","        \/\/ And implement hundreds of tokens.","        \/\/ You are allowed to give semantic tokens providers if you want to define values.","    }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, you can give this "},{"type":"codeVoice","code":"CustomRadioButtonComponentTokensProvider"},{"type":"text","text":" to your own theme implementation:"}]},{"code":["class LocalTheme: OrangeTheme {","","    override init() {","        super.init(radioButton: CustomRadioButtonComponentTokensProvider())","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"or to an already existing theme for example:"}]},{"code":["    OrangeTheme(radioButton: CustomRadioButtonComponentTokensProvider())"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineCont