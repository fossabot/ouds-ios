umentation\/OUDSThemesOrangeBusinessTools","title":"Theme Orange Business Tools","role":"collection","url":"\/documentation\/oudsthemesorangebusinesstools","kind":"symbol","images":[{"type":"icon","identifier":"ic_theme_orangebusinesstools.png"}]},"doc://OUDSThemesOrangeBusinessTools/documentation/OUDSThemesOrangeBusinessTools/OrangeBusinessToolsThemeColorChartSemanticTokensProvider":{"url":"\/documentation\/oudsthemesorangebusinesstools\/orangebusinesstoolsthemecolorchartsemantictokensprovider","kind":"symbol","identifier":"doc:\/\/OUDSThemesOrangeBusinessTools\/documentation\/OUDSThemesOrangeBusinessTools\/OrangeBusinessToolsThemeColorChartSemanticTokensProvider","type":"topic","title":"OrangeBusinessToolsThemeColorChartSemanticTokensProvider","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrangeBusinessToolsThemeColorChartSemanticTokensProvider"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OrangeBusinessToolsThemeColorChartSemanticTokensProvider"}],"abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"color semantic tokens of charts"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"multiple"}]},{"type":"text","text":" or not, and expose them."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllColorChartSemanticTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"OUDSTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users."}]},"https://ios.unified-design-system.orange.com/images/OUDSComponents/component_inputTag_OrangeBusinessTools.png":{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_inputTag_OrangeBusinessTools.png","type":"image","variants":[{"url":"http