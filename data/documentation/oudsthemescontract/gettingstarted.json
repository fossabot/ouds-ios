{"primaryContentSections":[{"content":[{"level":2,"text":"Integrate OUDS","type":"heading","anchor":"Integrate-OUDS"},{"level":3,"text":"Use Swift Package Manager","type":"heading","anchor":"Use-Swift-Package-Manager"},{"inlineContent":[{"type":"text","text":"If you want to add the iOS library of "},{"type":"emphasis","inlineContent":[{"text":"Orange Unified Design System","type":"text"}]},{"type":"text","text":", you need to add our "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" into your project."},{"type":"text","text":" "},{"type":"text","text":"To do that, add a new "},{"type":"emphasis","inlineContent":[{"text":"package dependency","type":"text"}]},{"type":"text","text":" to your "},{"type":"emphasis","inlineContent":[{"text":"Xcode","type":"text"}]},{"type":"text","text":" project by refering to it by "},{"type":"codeVoice","code":"github.com\/Orange-OpenSource\/ouds-ios"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You are free to choose wether or not you want a branch or a specific tag, pick the solution you want."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds"},{"type":"text","text":" for more details about versions, releases and tags. You can find release tags (e.g. "},{"type":"emphasis","inlineContent":[{"text":"0.18.0","type":"text"}]},{"type":"text","text":") and release candidates tags (e.g. "},{"type":"emphasis","inlineContent":[{"text":"0.18.0-rc3","type":"text"}]},{"type":"text","text":")."}],"type":"paragraph"},{"level":3,"text":"Import the librairies you need","type":"heading","anchor":"Import-the-librairies-you-need"},{"inlineContent":[{"type":"text","text":"You should use one (or several) of the following imports for your needs, which are basically "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" products."}],"type":"paragraph"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets.","type":"text"}]}]},{"type":"codeListing","syntax":"swift","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeBusinessTools \/\/ To use the Orange Business Tools theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"]},{"level":3,"text":"Or more simple, import umbrella library","type":"heading","anchor":"Or-more-simple-import-umbrella-library"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements.","type":"text"},{"text":" ","type":"text"},{"text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)","type":"text"},{"text":" ","type":"text"},{"text":"and useless constants.","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"Import the "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" product which suits your needs:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Umbrella","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUI","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All librairies listed above and all themes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIOrange","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All librairies listed above but with only Orange and Orange Business Tools themes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIWireframe","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All librairies listed above but with only Wireframe theme","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"OUDSSwiftUIOrangeSosh","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"All librairies listed above but with only Orange and Sosh themes","type":"text"}]}]]],"type":"table"},{"level":3,"text":"Chose your theme","type":"heading","anchor":"Chose-your-theme"},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"Orange Unified Design System","type":"text"}]},{"type":"text","text":" framework provides today four themes:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Orange","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The default one for Orange products and can be enriched \/ derivated","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Orange Business Tools","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For some Orange products with heavy \/ rich UI and dimensions constraints","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Sosh","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For Sosh products","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Wireframe","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles","type":"text"}]}]]],"type":"table"},{"level":3,"text":"Apply a theme","type":"heading","anchor":"Apply-a-theme"},{"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","type":"reference","isActive":true},{"type":"text","text":" also."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}]},{"size":1,"content":[{"syntax":"swift","type":"codeListing","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"]}]}],"type":"row","numberOfColumns":2},{"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"type":"text","text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want."}]}]},{"size":1,"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"]}]}],"type":"row","numberOfColumns":2},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"Keep in mind only one theme can be used within one ","type":"text"},{"type":"codeVoice","code":"OUDSThemeableView"},{"text":".","type":"text"}]}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"Welcome to Orange Unified Design System"}],"title":"Getting Started with OUDS","images":[{"type":"icon","identifier":"ic_unified_ds.png"},{"type":"card","identifier":"ic_unified_ds.png"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract"]]},"abstract":[{"text":"How to add the package as dependency, import libraries and use theme and components for your apps.","type":"text"}],"variants":[{"paths":["\/documentation\/oudsthemescontract\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Themes","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Modules"]}],"kind":"article","references":{"https://ios.unified-design-system.orange.com/documentation/ouds/themes":{"title":"This page may help","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","titleInlineContent":[{"text":"This page may help","type":"text"}],"url":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","type":"link"},"ic_component_intro.png":{"variants":[{"url":"\/images\/OUDSThemesContract\/ic_component_intro.png","traits":["1x","light"]}],"identifier":"ic_component_intro.png","type":"image","alt":null},"ic_module_intro.png":{"varian