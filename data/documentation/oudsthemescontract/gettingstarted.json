{"variants":[{"paths":["\/documentation\/oudsthemescontract\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"How to add the package as dependency, import libraries and use theme and components for your apps."}],"hierarchy":{"paths":[["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract"]]},"primaryContentSections":[{"content":[{"anchor":"Integrate-OUDS","level":2,"type":"heading","text":"Integrate OUDS"},{"anchor":"Use-Swift-Package-Manager","level":3,"type":"heading","text":"Use Swift Package Manager"},{"type":"paragraph","inlineContent":[{"text":"If you want to add the iOS library of ","type":"text"},{"inlineContent":[{"type":"text","text":"Orange Unified Design System"}],"type":"emphasis"},{"text":", you need to add our ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"text":" into your project.","type":"text"},{"text":" ","type":"text"},{"text":"To do that, add a new ","type":"text"},{"inlineContent":[{"type":"text","text":"package dependency"}],"type":"emphasis"},{"text":" to your ","type":"text"},{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"emphasis"},{"text":" project by refering to it by ","type":"text"},{"type":"codeVoice","code":"github.com\/Orange-OpenSource\/ouds-ios"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You are free to choose wether or not you want a branch or a specific tag, pick the solution you want.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can ","type":"text"},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","isActive":true,"type":"reference"},{"text":" for more details about versions, releases and tags. You can find release tags (e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"0.18.0"}],"type":"emphasis"},{"text":") and release candidates tags (e.g. ","type":"text"},{"inlineContent":[{"type":"text","text":"0.18.0-rc3"}],"type":"emphasis"},{"text":").","type":"text"}]},{"anchor":"Import-the-librairies-you-need","level":3,"type":"heading","text":"Import the librairies you need"},{"type":"paragraph","inlineContent":[{"text":"You should use one (or several) of the following imports for your needs, which are basically ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"text":" products.","type":"text"}]},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets."}],"type":"paragraph"}]},{"syntax":"swift","code":["import OUDSThemesContract \/\/ If you want to define your theme, use themes or OUDSThemeableView","import OUDSModules \/\/ To use modules","import OUDSComponents \/\/ To use components","import OUDSThemesOrange \/\/ To use the default Orange theme","import OUDSThemesOrangeBusinessTools \/\/ To use the Orange Business Tools theme","import OUDSThemesSosh \/\/ To use the Sosh theme","import OUDSThemesWireframe \/\/ To use the Wireframe theme","import OUDSTokensComponent \/\/ If you need to override or use directly components tokens","import OUDSTokenSemantic \/\/ If you need to override or use directly semantic tokens","import OUDSTokensRaw \/\/ If you need to override or use directly raw tokens","import OUDSFoundations \/\/ For some utilities"],"type":"codeListing"},{"anchor":"Or-more-simple-import-umbrella-library","level":3,"type":"heading","text":"Or more simple, import umbrella library"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements."},{"type":"text","text":" "},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Import the ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"text":" product which suits your needs:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Umbrella"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All librairies listed above and all themes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrange"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All librairies listed above but with only Orange and Orange Business Tools themes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIWireframe"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All librairies listed above but with only Wireframe theme"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"OUDSSwiftUIOrangeSosh"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All librairies listed above but with only Orange and Sosh themes"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Chose-your-theme","level":3,"type":"heading","text":"Chose your theme"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"Orange Unified Design System"}],"type":"emphasis"},{"text":" framework provides today four themes:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Orange"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The default one for Orange products and can be enriched \/ derivated"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Orange Business Tools"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For some Orange products with heavy \/ rich UI and dimensions constraints"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Sosh"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For Sosh products"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Wireframe"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For mockups, prototypes and prooves of concepts witouth Orange-flavoured styles"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Apply-a-theme","level":3,"type":"heading","text":"Apply a theme"},{"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/oudsthemeableview\/","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/ios.unified-design-system.orange.com\/documentation\/ouds\/themes","isActive":true},{"type":"text","text":" also."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}]},{"size":1,"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          OUDSThemeableView(theme: OrangeTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"syntax":"swift","type":"codeListing"}]}],"numberOfColumns":2,"type":"row"},{"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}]}]},{"size":1,"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"]}]}],"numberOfColumns":2,"type":"row"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"type":"codeVoice","code":"OUDSThemeableView"},{"type":"text","text":"."}]}]}],"kind":"content"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Tokens","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Themes","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Components","doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Modules"],"anchor":"Essentials","generated":true}],"metadata":{"title":"Getting Started with OUDS","images":[{"identifier":"ic_unified_ds.png","type":"icon"},{"identifier":"ic_unified_ds.png","type":"card"}],"role":"article","modules":[{"name":"Welcome to Orange Unified Design System"}],"roleHeading":"Article"},"sections":[],"references":{"ic_design_token_intro.png":{"identifier":"ic_design_token_intro.png","alt":null,"type":"image","variants":[{"url":"\/images\/OUDSThemesContract\/ic_design_token_intro.png","traits":["1x","light"]}]},"doc://OUDSThemesContract/documentation/OUDSThemesContract/Modules":{"kind":"article","identifier":"doc:\/\/OUDSThemesContract\/documentation\/OUDSThemesContract\/Modules","abstract":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"module","type":"text"}],"type":"emphasis"},{"text":" can be seen as a set of features and components to fill a need.","type":"text"}],"type":"