/OUDSComponents/OUDSCheckboxPicker":{"url":"\/documentation\/oudscomponents\/oudscheckboxpicker","abstract":[{"type":"text","text":"A picker allowing to expose several checkboxes and select some of them within the others."},{"type":"text","text":" "},{"type":"text","text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose the choosen values using this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","isActive":true},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSCheckboxPicker","kind":"identifier"}],"title":"OUDSCheckboxPicker","navigatorTitle":[{"kind":"identifier","text":"OUDSCheckboxPicker"}],"type":"topic","kind":"symbol"},"doc://OUDSComponents/documentation/OUDSComponents":{"url":"\/documentation\/oudscomponents","role":"collection","type":"topic","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","abstract":[{"text":"The catalog of all components provided by OUDS. It contains also ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","title":"Components"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSCheckboxItem":{"title":"OUDSCheckboxItem","url":"\/documentation\/oudscomponents\/oudscheckboxitem","abstract":[{"text":"Checkbox is a UI element that allows to se