."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSButton","type":"topic","title":"OUDSButton","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSButton","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSButton","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudsbutton"},"component_button_Orange":{"variants":[{"url":"\/images\/OUDSComponents\/component_button_Orange.png","traits":["1x","light"]}],"type":"image","alt":"A button component in light and dark modes with Orange theme","identifier":"component_button_Orange"}}}