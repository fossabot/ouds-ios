ire additional visual elements.","type":"text"},{"text":" ","type":"text"},{"text":"Other layouts are available for this component like: ","type":"text"},{"inlineContent":[{"text":"text + icon","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"icon only","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]}}}