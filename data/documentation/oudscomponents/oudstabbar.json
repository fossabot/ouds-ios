igations":{"kind":"article","type":"topic","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"role":"article","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Navigations","url":"\/documentation\/oudscomponents\/navigations","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"title":"Navigations"},"component_tabBar_LiquidGlass_Orange_light":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_light.png","traits":["1x","light"]}],"alt":"A tab bar component in light mode with Liquid Glass effect and Orange theme","identifier":"component_tabBar_LiquidGlass_Orange_light","type":"image"},"component_tabBar_LiquidGlass_Sosh_light":{"type":"image","alt":"A  tab bar component in light mode with Liquid Glass effect and Sosh theme","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Sosh_light.png"}],"identifier":"component_tabBar_LiquidGlass_Sosh_light"},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(selected:count:content:)":{"title":"init(selected:count:content:)","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."}],"url":"\/documentation\/oudscomponents\/oudstabbar\/init(selected:count:content:)","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(selected:count:content:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSBadge":{"kind":"symbol","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OUDSBadge"}],"title":"OUDSBadge","navigatorTitle":[{"kind":"identifier","text":"OUDSBadge"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadge","role":"symbol","url":"\/documentation\/oudscomponents\/oudsbadge"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/body":{"title":"body","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab item"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Warning: rendering wil change depending to OS version!"}],"url":"\/documentation\/oudscomponents\/oudstabbar\/body","kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":