er and a selected tab indicator for legacy layouts."}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudstabbar\/body","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/body"},"component_tabBar_OrangeBusinessTools_dark":{"identifier":"component_tabBar_OrangeBusinessTools_dark","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_OrangeBusinessTools_dark.png"}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and Orange Business Tools theme"},"component_tabBar_LiquidGlass_Orange_dark":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_Orange_dark.png"}],"identifier":"component_tabBar_LiquidGlass_Orange_dark","type":"image","alt":"A tab bar component in dark mode with Liquid Glass effect and Orange theme"},"component_tabBar_Orange_dark":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_Orange_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_Orange_dark","alt":"A tab bar component in dark mode without Liquid Glass effect and Orange theme"},"component_tabBar_LiquidGlass_OrangeBusinessTools_light":{"identifier":"component_tabBar_LiquidGlass_OrangeBusinessTools_light","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeBusinessTools_light.png"}],"alt":"A  tab bar component in light mode with Liquid Glass effect and Orange Business Tools theme"},"component_tabBar_Sosh_dark":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_dark.png"}],"identifier":"component_tabBar_Sosh_dark","type":"image","alt":"A  tab bar component in dark mode without Liquid Glass effect and Sosh theme"},"component_tabBar_LiquidGlass_OrangeBusinessTools_dark":{"variants":[{"url":"\/images\/OUDSComponents\/component_tabBar_LiquidGlass_OrangeBusinessTools_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_LiquidGlass_OrangeBusinessTools_dark","alt":"A  tab bar component in dark mode with Liquid Glass effect and Orange Business Tools theme"},"component_tabBar_Orange_light":{"identifier":"component_tabBar_Orange_light","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Orange_light.png"}],"alt":"A tab bar component in light mode without Liquid Glass effect and Orange theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/init(content:)":{"type":"topic","title":"init(content:)","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTabBar\/init(content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/oudscomponents\/oudstabbar\/init(content:)","kind":"symbol","abstract":[{"text":"Defines the tab bar component with given tab bar items.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS lower than 26, prefer instead ","type":"text"},{"code":"OUDSTabBar(selected:count:content:)","type":"codeVoice"}]},"component_tabBar_Sosh_light":{"variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_tabBar_Sosh_light.png"}],"identifier":"component_tabBar_Sosh_light","type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and Sosh theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTabBar/View-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/OUDSComponents\/document