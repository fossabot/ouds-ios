{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/oudscheckboxpicker"]}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker\/init(selections:checkboxes:placement:isReversed:isError:isReadOnly:hasDivider:itemsSpacing:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker\/body"],"title":"Instance Properties"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker\/View-Implementations","doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker\/View-Implementations"],"title":"Default Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxPicker"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"externalID":"s:14OUDSComponents18OUDSCheckboxPickerV","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCheckboxPicker"}],"roleHeading":"Structure","title":"OUDSCheckboxPicker","navigatorTitle":[{"kind":"identifier","text":"OUDSCheckboxPicker"}],"modules":[{"name":"Components"}],"platforms":[{"beta":false,"deprecated":false,"name":"iOS","introducedAt":"15.0","unavailable":false},{"beta":false,"deprecated":false,"name":"macOS","introducedAt":"15.0","unavailable":false},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false}],"role":"symbol"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OUDSComponents\/s8SendableP","doc:\/\/OUDSComponents\/s16SendableMetatypeP","doc:\/\/OUDSComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OUDSCheckboxPicker"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Tag"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Tag"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Controls"],"kind":"mentions"},{"content":[{"level":2,"anchor":"Accessibility-considerations","type":"heading","text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a chekcbox trait.","type":"text"},{"text":" ","type":"text"},{"text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioPickerData","isActive":true,"type":"reference"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"In addition the root item of the picker has for accessiiblity identifier the displayed text.","type":"text"}]},{"level":2,"anchor":"Forbidden-by-design","type":"heading","text":"Forbidden by design"},{"type":"paragraph","inlineContent":[{"text":"The design system does not allow to have ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","isActive":true,"type":"reference"},{"text":" in both an error situation and a read only state.","type":"text"},{"text":" ","type":"text"},{"text":"The design system does not allow to have ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","isActive":true,"type":"reference"},{"text":" in both an error situation and a disabled state.","type":"text"},{"text":" ","type":"text"},{"text":"The design system does not allow to have ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSCheckboxItem","isActive":true,"type":"reference"},{"text":" in both a read only and a disabled state.","type":"text"}]},{"level":2,"anchor":"Code-samples","type":"heading","text":"Code samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Define the elements to display in checkboxes using OUDSCheckboxPickerData.","    \/\/ This object has the same properties as the OUDSCheckboxItem,","    \/\/ and some of them are optional with default values set","    var someDataToPopulate: [OUDSCheckboxPickerData<String>] {","        [","        OUDSCheckboxPickerData<String>(tag: \"Choice_1\",","                                       label: \"Virgin Holy Lava\",","                                       extraLabel: \"Very spicy\",","                                       helper: \"No alcohol, only tasty flavors\",","                                       icon: Image(systemName: \"flame\")),","","        OUDSCheckboxPickerData<String>(tag: \"Choice_2\",","                                       label: \"IPA beer\",","                                       helper: \"From Brewdog company\",","                                       icon: Image(systemName: \"dog.fill\")),","","        OUDSCheckboxPickerData<String>(tag: \"Choice_3\",","                                       label: \"Mineral water\",","                                       icon: Image(systemName: \"waterbottle.fill\")),","        ]","    }","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [String] = [\"Choice_1\"] \/\/ or empty if nothing selected","","    \/\/ Here the picker is vertical by default","    OUDSCheckboxPicker(selections: $selections, checkboxes: someDataToPopulate)","","    \/\/ The picker can be vertical and have a root item with a label and a counter","    OUDSCheckboxPicker(selections: $selections,","                       placement: .verticalRooted(label, .textAndCount))","","    \/\/ The picker can apply some settings to all its radio buttons.","    \/\/ It can be also horizontal with a scroll indicator.","    \/\/ Here all the the checkboxes are in read only mode and use reversed layout.","    \/\/ Here the picker is horizontal and shows the scroll indicator","    OUDSCheckboxPicker(selections: $selections,","                       checkboxes: someDataToPopulate)","                       isReversed: true,","                       isReadOnly: true,","                       placement: .horizontal(true))"]},{"level":2,"anchor":"Design-documentation","type":"heading","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"text":"There is no online specification as this component is not an official OUDS one","type":"text"}]},{"level":2,"anchor":"Themes-rendering","type":"heading","text":"Themes rendering"},{"level":3,"anchor":"Orange","type":"heading","text":"Orange"},{"type":"paragraph","inlineContent":[{"identifier":"component_checkboxPicker_Orange","type":"image"}]},{"style":"note","name":"Since","type":"aside","content":[{"inlineContent":[{"type":"text","text":"0.14.0"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"abstract":[{"type":"text","text":"A picker allowing to expose several checkboxes and select 