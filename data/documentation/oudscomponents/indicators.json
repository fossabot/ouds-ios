{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"level":3,"text":"Badge","anchor":"Badge","type":"heading"},{"tabs":[{"title":"Orange","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_Orange"}]}]},{"title":"Orange Business Tools","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_OrangeBusinessTools"}]}]},{"title":"Sosh","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_Sosh"}]}]},{"title":"Wireframe","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_Wireframe"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSBadge"},{"type":"text","text":" is a small UI element used to highlight status, notifications, or categorization within an interface. It is often displayed as a label or indicator with a distinct background color and text."}],"type":"paragraph"},{"tabs":[{"title":"SwiftUI","content":[{"syntax":"swift","code":["    \/\/ Info badge in medium size without information","    OUDSBadge(status: .info, size: .medium)","","    \/\/ Negative badge in medium size with count information","    OUDSBadge(count: 1, status: .negative, size: .medium)","","    \/\/ Neutral badge in medium size with an image","    OUDSBadge(status: .neutral(icon: Image(decorative: \"ic_heart\")), accessibilityLabel: \"Like\", size: .medium)"],"type":"codeListing"}]},{"title":"UIKit (experimental)","content":[{"type":"codeListing","syntax":"swift","code":["    import OUDSComponentsUIKit","    ","    \/\/ Info badge in medium size without information","    OUDSUIKit.createBadge(status: .info, size: .medium)","","    \/\/ Negative badge in medium size with count information","    OUOUDSUIKit.createBadge(count: 1, status: .negative, size: .medium)","","    \/\/ Neutral badge in medium size with an image","    OUDSUIKit.createBadge(status: .neutral(icon: Image(decorative: \"ic_heart\")), accessibilityLabel: \"Like\", size: .medium)"]}]}],"type":"tabNavigator"},{"level":3,"text":"Tag","anchor":"Tag","type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_Orange"}]}],"title":"Orange"},{"title":"Orange Business Tools","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_OrangeBusinessTools"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_Sosh"}]}],"title":"Sosh"},{"title":"Wireframe","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_Wireframe"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag","type":"reference","isActive":true},{"text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content.","type":"text"}]},{"tabs":[{"content":[{"syntax":"swift","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","OUDSTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","OUDSTag(label: \"Label\")","    ","\/\/ Tag with negative status with bullet","OUDSTag(label: \"Label\", status: .negative(leading: .bullet)","    ","\/\/ Tag with neutral status with a custom decorative icon","OUDSTag(label: \"Label\", status: .neutral(icon: Image(decorative: \"ic_heart\")))","\/\/ If your layout is in RTL mode but your tag has an icon with another meaning because of bad orientation,","\/\/ you can flip the icon","OUDSTag(label: \"Label\", status: .neutral(icon: Image(decorative: \"ic_heart\"), flipIcon: true))","    ","\/\/ Text with neutral status with bullet","OUDSTag(label: \"Label\", status: .neutral(bullet: true))","    ","\/\/ Tag with loader with rounded shape in small size","OUDSTag(loadingLabel: \"Label\", shape: .rounded, size: .small)"],"type":"codeListing"}],"title":"SwiftUI"},{"content":[{"syntax":"swift","code":["import OUDSComponentsUIKit","    ","\/\/ Text only with neutral status, for emphasized hierarchy with rounded shape in default size            ","OUDSUIKit.createTag(label: \"label\",","                    status: .neutral,","                    appearance: .emphasized,","                    shape: .rounded,","                    size: .default,","\/\/ Or also","OUDSUIKit.createTag(label: \"label\")","    ","\/\/ ext with bullet and negative status, using default hierarchy (emphasized), shape (rounded) and size (default)","    OUDSUIKit.createTag(label: \"Label\", status: .negative(leading: .bullet)","","\/\/ Tag with label and icon with image","OUDSUIKit.createTag((label: \"Label\", status: .neutral(icon: Image(decorative: \"ic_heart\")))","","\/\/ Tag with label and loader","OUDSUIKit.createTag(loadingLabel: \"Label\", shape: .rounded, size: .small)"],"type":"codeListing"}],"title":"UIKit (experimental)"}],"type":"tabNavigator"},{"level":3,"text":"Input Tag","anchor":"Input-Tag","type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_inputTag_Orange"}],"type":"paragraph"}],"title":"Orange"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_OrangeBusinessTools","type":"image"}],"type":"paragraph"}],"title":"Orange Business Tools"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Sosh","type":"image"}],"type":"paragraph"}],"title":"Sosh"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_Wireframe","type":"image"}],"type":"paragraph"}],"title":"Wireframe"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSInputTag"},{"text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap.","type":"text"}]},{"syntax":"swift","code":["\/\/ Create an input tag","OUDSInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    OUDSInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/Indicators","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Indicators","modules":[{"name":"Components"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","roleHeading":"Article"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"strong"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oudscomponents\/indicators"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OUDSComponents\/documentation\/OUDSComponents"]]},"references":{"component_badge_OrangeBusinessTools":{"identifier":"component_badge_OrangeBusinessTools","alt":"A badge component in light and dark modes with Orange Business Tools theme","variants":[{"url":"\/images\/OUDSComponents\/component_badge_OrangeBusinessTools.png","traits":["1x","light"]}],"type":"image"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","t