this “tag”.","type":"text"},{"text":" ","type":"text"},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioItem","type":"reference","isActive":true},{"text":" (divider, read only and error mode, layout and outlined)","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OUDSRadioPicker"}],"title":"OUDSRadioPicker"},"doc://OUDSComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"component_radioItem_Orange":{"identifier":"component_radioItem_Orange","alt":"A radio item component in light and dark modes with Orange theme","variants":[{"url":"\/images\/OUDSComponents\/component_radioItem_Orange.png","traits":["1x","light"]}],"type":"image"},"component_radioItem_OrangeBusinessTools":{"variants":[{"url":"\/images\/OUDSComponents\/component_radioItem_OrangeBusinessTools.png","traits":["1x","light"]}],"identifier":"component_radioItem_OrangeBusinessTools","alt":"A radio item component in light and dark modes with Orange Business Tools theme","type":"image"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSRadioItem":{"abstract":[{"text":"Radio button item is a UI element that allows to select a single option from a set of mutually exclusive choices.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Radio button item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSRadioItem","navigatorTitle":[{"text":"OUDSRadioItem","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oudscomponents\/oudsradioitem","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"OUDSRadioItem","kind":"identifier"}],"title":"OUDSRadioItem","role":"s