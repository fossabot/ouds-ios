Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"controls"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"strong"},{"text":".","type":"text"}],"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"kind":"article"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Helperlink":{"abstract":[{"type":"text","text":"Used to describe the helper link above the helper text."}],"navigatorTitle":[{"kind":"identifier","text":"Helperlink"}],"kind":"symbol","type":"topic","title":"OUDSTextInput.Helperlink","role":"symbol","url":"\/documentation\/oudscomponents\/oudstextinput\/helperlink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Helperlink"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Helperlink"},"https://developer.apple.com/design/human-interface-guidelines/playing-haptics":{"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","url":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","type":"link","title":"Human Interface Guidelines of Apple","titleInlineContent":[{"type":"text","text":"Human Interface Guidelines of Apple"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/View-Implementations":{"abstract":[],"kind":"article","type":"topic","title":"View Implementations","role":"collectionGroup","url":"\/documentation\/oudscomponents\/oudstextinput\/view-implementations","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/View-Implementations"},"component_textInput_Sosh":{"identifier":"component_textInput_Sosh","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_Sosh.png","traits":["1x","light"]}],"type":"image","alt":"A text input component in light and dark modes with Sosh theme"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","alt":null},"https://r.orange.fr/r/S-ouds-doc-text-input":{"identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-text-input","url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-text-input","type":"link","title":"unified-design-system.orange.com","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}]},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://OUDSComponents/s8SendableP":{"identifier":"doc:\/\/OUDSComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/init(label:text:placeholder:prefix:suffix:leadingIcon:flipLeadingIcon:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)":{"kind":"symbol","abstract":[{"type":"text","text":"Creates a text input."}],"role":"symbol","title":"init(label:text:placeholder:prefix:suffix:leadingIcon:flipLeadingIcon:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"label","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"placeholder","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"prefix","kind":"externalParam"},