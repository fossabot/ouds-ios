,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/init(label:text:placeholder:prefix:suffix:leadingIcon:flipLeadingIcon:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)","url":"\/documentation\/oudscomponents\/oudstextinput\/init(label:text:placeholder:prefix:suffix:leadingicon:flipleadingicon:trailingaction:helpertext:helperlink:isoutlined:constrainedmaxwidth:status:)"},"component_textInput_Orange":{"alt":"A text input component in light and dark modes with Orange theme","type":"image","identifier":"component_textInput_Orange","variants":[{"traits":["1x","light"],"url":"\/images\/OUDSComponents\/component_textInput_Orange.png"}]},"doc://OUDSComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/OUDSComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View","type":"unresolvable"},"component_textInput_Sosh":{"identifier":"component_textInput_Sosh","type":"image","alt":"A text input component in light and dark modes with Sosh theme","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_Sosh.png","traits":["1x","light"]}]},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","type":"image","alt":null,"variants":[{"url":"\/images\/OUDSComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/TrailingAction":{"title":"OUDSTextInput.TrailingAction","type":"topic","abstract":[{"text":"Used to describe the trailing action of the text input","type":"text"}],"navigatorTitle":[{"text":"TrailingAction","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrailingAction","kind":"identifier"}],"url":"\/documentation\/oudscomponents\/oudstextinput\/trailingaction","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/TrailingAction"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Helperlink":{"abstract":[{"type":"text","text":"Used to describe the helper link above the helper text."}],"role":"symbol","url":"\/documentation\/oudscomponents\/oudstextinput\/helperlink","navigatorTitle":[{"text":"Helperlink","kind":"identifier"}],"type":"topic","title":"OUDSTextInput.Helperlink","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Helperlink"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Helperlink"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/body":{"title":"body","abstract":[],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/body","url":"\/documentation\/oudscomponents\/oudstextinput\/body","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"body","kind":"identifier"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"type":"topic"},"doc://OUDSComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Status":{"title":"OUDSTextInput.Status","abstract":[{"text":"Define all available status for the text input","type":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Status","url":"\/documentation\/oudscomponents\/oudstextinput\/status","navigatorTitle":[{"text":"Status","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Style":{"title":"OUDSTextInput.Style","abstract":[{"type":"text","text":"The prefered style of the text input"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Style","url":"\/documentation\/oudscomponents\/oudstextinput\/style","navigatorTitle":[{"text":"Style","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"type":"topic"},"component_textInput_Wireframe":{"type":"image","alt":"A text input component in light and dark modes with Wireframe theme","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_Wireframe.png","traits":["1x","light"]}],"identifier":"component_textInput_Wireframe"},"https://r.orange.fr/r/S-ouds-doc-text-input":{"url":"https:\/\/r.orange.fr\/r\/S-ouds-doc-text-input","type":"link","identifier":"https:\/\/r.orange.fr\/r\/S-ouds-doc-text-input","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"title":"unified-design-system.orange.com"},"component_textInput_OrangeBusinessTools":{"identifier":"component_textInput_OrangeBusinessTools","type":"image","alt":"A text input component in light and dark modes with Orange Business Tools theme","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_OrangeBusinessTools.png","traits":["1x","light"]}]},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"title":"Components","role":"collection","url":"\/documentation\/oudscomponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}]},"https://developer.apple.com/design/human-interface-guidelines/playing-haptics":{"identifier":"https:\/\/developer.apple.com