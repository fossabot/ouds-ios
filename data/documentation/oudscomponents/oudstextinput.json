DSComponents13OUDSTextInputV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Status","preciseIdentifier":"s:14OUDSComponents13OUDSTextInputV6StatusO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/init(label:text:placeholder:prefix:suffix:leadingIcon:flipLeadingIcon:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)","url":"\/documentation\/oudscomponents\/oudstextinput\/init(label:text:placeholder:prefix:suffix:leadingicon:flipleadingicon:trailingaction:helpertext:helperlink:isoutlined:constrainedmaxwidth:status:)","type":"topic"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/body":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/body","url":"\/documentation\/oudscomponents\/oudstextinput\/body","role":"symbol","title":"body"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput":{"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput","type":"reference"},{"text":" is a user interface component that allows users to enter, edit, or select","type":"text"},{"text":" ","type":"text"},{"text":"single-line textual data. It’s one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput","url":"\/documentation\/oudscomponents\/oudstextinput","title":"OUDSTextInput","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OUDSTextInput","kind":"identifier"}],"navigatorTitle":[{"text":"OUDSTextInput","kind":"identifier"}]},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTextInput/Style":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"url":"\/documentation\/oudscomponents\/oudstextinput\/style","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTextInput\/Style","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Style"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The prefered style of the text input","type":"text"}],"title":"OUDSTextInput.Style"},"component_textInput_OrangeBusinessTools":{"identifier":"component_textInput_OrangeBusinessTools","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_OrangeBusinessTools.png","traits":["1x","light"]}],"type":"image","alt":"A text input component in light and dark modes with Orange Business Tools theme"},"component_textInput_Wireframe":{"identifier":"component_textInput_Wireframe","variants":[{"url":"\/images\/OUDSComponents\/component_textInput_Wireframe.png","traits":["1x","light"]}],"type":"image","alt":"A text input component in light and dark modes with Wireframe theme"},"doc://OUDSComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/OUDSComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"}}}