pe":"image","identifier":"component_tag_OrangeBusinessTools","alt":"A tag component in light and dark modes with Orange Business Tools theme"},"doc://OUDSComponents/documentation/OUDSComponents/OUDSTag/Status":{"title":"OUDSTag.Status","url":"\/documentation\/oudscomponents\/oudstag\/status","abstract":[{"type":"text","text":"The status of an "},{"type":"codeVoice","code":"OUDSTag"},{"text":" determines the leading element, the background","type":"text"},{"text":" ","type":"text"},{"text":"and the content colors of the tag according to the category.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Status"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Status"}],"type":"topic","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents\/OUDSTag\/Status"},"doc://OUDSComponents/documentation/OUDSComponents":{"kind":"symbol","identifier":"doc:\/\/OUDSComponents\/documentation\/OUDSComponents","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by OUDS. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"title":"Components","role":"collection","url":"\/documentation\/oudscomponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}]},"doc://OUDSComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/OUDSComponents\/s8SendableP","title":"Swift.Sendable"}}}