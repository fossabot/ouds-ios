type":"codeVoice","code":"OUDSTheme"},{"text":", uses all the ","type":"text"},{"inlineContent":[{"text":"Orange Unified Design System","type":"text"}],"type":"emphasis"},{"text":" kit and brings the Sosh brand colors and assets.","type":"text"}],"type":"paragraph"},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"This theme embeds and registers the fonts for the Sosh theme, you just need to use the theme object as is.","type":"text"}]}],"type":"aside","style":"tip"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"The Sosh theme does not embed colors for charts yet and is read only: it cannot be subclassed or derivated"}],"type":"paragraph"}],"type":"aside","style":"important"},{"type":"heading","level":2,"text":"How to use the theme","anchor":"How-to-use-the-theme"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","type":"reference","isActive":true},{"text":" directly. To use the ","type":"text"},{"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true,"type":"reference"},{"text":" without further modifications, you will have to use the ","type":"text"},{"code":"OUDSThemeableView","type":"codeVoice"},{"text":" for your root view and give it an instance of ","type":"text"},{"identifier":"doc:\/\/OUDSThemesSosh\/documentation\/OUDSThemesSosh\/SoshTheme","isActive":true,"type":"reference"},{"text":". Keep in mind the themes are ","type":"text"},{"inlineContent":[{"text":"Swift class objects","type":"text"}],"type":"emphasis"},{"text":" and can be heavy, so you may use only as instance as singleton and not store any properties.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct YourApp: App {","    var body: some Scene {","        WindowGroup {","            OUDSThemeableView(theme: SoshTheme()) {","                \/\/ Your root view","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Then, in your views, you can simply use the theme through an environment variable to get the tokens:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SomeView: View {","","    \/\/ Get OUDS environment variable for theme thanks to themeable view","    @Environment(\\.theme) var theme","    ","    var body: some View {","        ","        \/\/ Use the theme to retrieve the tokens","        \/\/ For spaces: theme.spaces","        \/\/ For sizes: theme.sizes","        \/\/ For borders: theme.borders","        \/\/ For elevations: theme.elevations","        \/\/ For opacities: theme.opacities","        \/\/ For colors: theme.colors","        \/\/ For button configuration: theme.button","        \/\/ For link configuration: theme.link","        \/\/ Etc.","    }","}"]},{"type":"heading","level":2,"text":"How to tune the theme","anchor":"How-to-tune-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot tune the Sosh theme."}]},{"type":"heading","level":2,"text":"Typography","anchor":"Typography"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sosh theme uses its Sosh font and must not use others."}]},{"type":"heading","level":2,"text":"How to enrich the theme","anchor":"How-to-enrich-the-theme"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot derivate the Sosh theme."}]},{"type":"heading","level":2,"text":"How it looks like","anchor":"How-it-looks-like"},{"text":"Actions","type":"heading","level":3,"anchor":"Actions"},{"inlineContent":[{"identifier":"https:\/\/ios.unified-design-system.orange.com\/images\/OUDSComponents\/component_button_Sosh.png","type":"image"}],"type":"paragraph"},{"text":"Controls","type":"heading","level":3,"anchor":"Controls"},{"text":"Checkboxes","type":"heading","level":4,"anchor":"Checkboxes"},{"type":"tabNavigator","tabs":[{"title":"Checkbox","content":[{"type":"paragraph","inline