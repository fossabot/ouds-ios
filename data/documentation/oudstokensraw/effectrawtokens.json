ined as a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NSObject","type":"codeVoice"},{"text":" so as to be shared through ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" with extensions and protocols within modules.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationCompositeRawToken","role":"symbol","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/oudstokensraw\/elevationcompositerawtoken","type":"topic"},"doc://OUDSTokensRaw/documentation/OUDSTokensRaw/ElevationRawTokens":{"title":"ElevationRawTokens","type":"topic","role":"symbol","navigatorTitle":[{"text":"ElevationRawTokens","kind":"identifier"}],"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens","abstract":[{"type":"text","text":"Defined as the group of all "},{"type":"strong","inlineContent":[{"text":"raw tokens","type":"text"}]},{"type":"text","text":" related to "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Values are defined in "},{"type":"emphasis","inlineContent":[{"text":"ElevationRawTokens+Values.swift","type":"text"}]},{"type":"text","text":" file updated by the tokenator and "},{"type":"emphasis","inlineContent":[{"text":"ElevationRawTokens+Values.swift","type":"text"}]},{"type":"text","text":" updated manualy by the development team."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OUDSTokensRaw\/documentation\/OUDSTokensRaw\/ElevationRawTokens"},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "}